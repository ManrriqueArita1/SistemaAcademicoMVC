@model IEnumerable<SistemaAcademicoMVC.Models.Estudiante>

@{
    ViewBag.Title = "Estudiantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Estudiantes</h2>

<h4>Agregar Estudiante</h4>

@using (Html.BeginForm("Create", "Estudiantes", FormMethod.Post))
{
    <div class="form-group">
        <label for="Nombre" class="control-label">Nombre:</label>
        <input name="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Correo" class="control-label">Correo:</label>
        <input name="Correo" class="form-control" />
    </div>
    <div class="form-group">
        <br />
        <input type="submit" value="Agregar" class="btn btn-primary" />
    </div>
}

<hr />
<h4>Lista de Estudiantes</h4>

<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Correo)
                </td>
                <td>
                    @Html.ActionLink(
                        "Ver detalle",
                        "Details",
                        new { id = item.Id }
                    )
                    |
                    @Html.ActionLink(
                        "Eliminar Estudiante",
                        "Delete",
                        new { id = item.Id },
                        new
                        {
                            onclick = "return confirm('¿Está seguro de eliminar este estudiante?');"
                        }
                    )
                </td>
            </tr>
        }
    </tbody>
</table>
